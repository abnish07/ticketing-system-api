    "nodemailer": "latest",
    "pino": "latest",
    "qrcode": "latest",
    "rate-limiter-flexible": "latest",
    "sequelize": "latest",
    "pg": "latest",
    "pg-hstore": "latest",
    "speakeasy": "latest",
    "uuid": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "eslint": "latest",
    "eslint-config-standard": "latest",
    "eslint-plugin-import": "latest",
    "eslint-plugin-n": "latest",
    "nodemon": "latest",
